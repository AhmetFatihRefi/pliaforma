# Pliaforma production değişkenleri — kopyalayın: cp deploy/.env.example deploy/.env
# Kullanım: docker compose --env-file deploy/.env -f docker-compose.prod.yml up -d --build

# --- PostgreSQL ---
POSTGRES_USER=pliaforma
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=pliaforma

# --- JWT (en az 32 BAYT; secret yoksa/kısaysa backend AÇILMAZ) ---
# UYARI: Production'da değer 'CHANGE_ME' içerirse backend AÇILMAZ (Sprint 31B-1 fail-fast guard).
# Gerçek, rastgele secret üretin, örn:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_byte_random_secret_value
JWT_ISSUER=Pliaforma
JWT_AUDIENCE=Pliaforma

# --- Seed admin (opsiyonel; ikisi de boşsa admin tohumlanmaz) ---
# UYARI: Production'da parola 'CHANGE_ME' veya bilinen örnek ('Admin!2345') içerirse backend AÇILMAZ.
# Güçlü/benzersiz bir parola verin ya da boş bırakın (admin tohumlanmaz).
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Genel origin (CORS allowlist + cookie/host beklentisi + e-posta link tabanı) ---
# nginx ile same-origin çalışıldığından CORS ana akış için gerekmez; yine de allowlist'e yazılır.
# Email__PublicOrigin de bunu kullanır (doğrulama/sıfırlama linkleri bu origin ile kurulur).
# Prod'da MUTLAKA https:// olmalı (CORS allowlist + Secure cookie + e-posta link tabanı bunu kullanır).
# TLS: deploy/certs/{fullchain,privkey}.pem yoksa nginx açılmaz (HTTPS zorunlu). Bkz. PILOT-DEPLOY-DRY-RUN.md.
#
# ÖNEMLİ (Sprint 49 — same-origin): Refresh cookie host-only + SameSite=Strict + Path=/api/auth'tur. Bu yüzden
# frontend ve API AYNI origin'den servis edilmelidir. TEK bir canonical host seçin (ör. https://pliaforma.com)
# ve www./app./api. alt alanlarını nginx ile buna 301 yönlendirin. PUBLIC_ORIGIN bu canonical host olmalı.
# api.pliaforma.com'u AYRI bir origin olarak backend'e vermeyin (cross-origin cookie kurulumu = post-pilot işi).
PUBLIC_ORIGIN=https://pliaforma.com

# --- İzleme (Prometheus/Grafana) — OPSİYONEL, pilotta KAPALI varsayılır ---
# Yalnız docker-compose.monitoring.yml çalıştırılacaksa gerekir. Grafana admin parolası ZORUNLU
# (yoksa monitoring compose hata verir); default admin/admin YOKTUR. Portlar 127.0.0.1'e bind'lidir.
GF_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password

# --- MFA (Sprint 31-MFA: Owner/StudioAdmin TOTP) ---
# Pilotta ZORUNLU. Mfa:Enabled=false ise Production'da backend AÇILMAZ (fail-fast).
# EncryptionKey TOTP secret'larını AES-256-GCM ile şifreler — KRITIK SECRET (JWT secret gibi yedekle).
# Kaybı → kullanıcılar yeniden MFA kurmak zorunda kalır (recovery code'lar bağımsız çalışır). Üret: openssl rand -base64 32
MFA_ENABLED=true
MFA_ENCRYPTION_KEY=CHANGE_ME_base64_min_32_byte_key
# Sprint 50: "Bu cihazı hatırla" güven süresi (gün). Owner/Admin MFA doğrularken "bu cihazda tekrar sorma"
# işaretlerse aynı cihazda bu kadar gün 2. faktör atlanır (MFA KAPANMAZ). Varsayılan 30.
MFA_TRUSTED_DEVICE_DAYS=30

# --- E-posta (Sprint 16: doğrulama + şifre sıfırlama) ---
# SenderMode: Smtp (prod önerilen) | Log (yalnız dev/test, gönderim yok loglar) | Disabled (prod'da KULLANMAYIN).
# Smtp iken PublicOrigin + SMTP_HOST + EMAIL_FROM_ADDRESS ZORUNLU; eksikse backend AÇILMAZ (fail-fast).
# Prod'da SenderMode=Disabled → backend AÇILMAZ (bilinçliyse Email__AllowDisabledInProduction=true gerekir).
EMAIL_SENDER_MODE=Smtp
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Pliaforma
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_USE_TLS=true

# --- CSP (Sprint 31C-2: enforce + nonce) ---
# Next.js proxy (src/proxy.ts) CSP'yi sahiplenir; nginx CSP üretmez. Runtime env (rebuild gerekmez).
# report-only (ilk deploy, BLOKLAMAZ) | enforce (BLOKLAR) | disabled (acil rollback).
# Akış: ilk deploy report-only → canlı doğrulama → CSP_MODE=enforce + container restart.
CSP_MODE=report-only

# --- Pilot Simple People Mode (Sprint 46/47) ---
# Hoca ad-soyad ile guest öğrenci ekleyip Regular derse alabilir (StudentContract/Line.IsPilot ile tüm finans/
# rapor yüzeylerinden gizlenir). Varsayılan false (kapalı) — yalnız BU pilot stüdyo için true yapın.
# Kapalıyken davranış v1.37.0 öncesiyle birebir aynıdır (Instructor guest-create/minimal-list/booking → 403).
# >>> BU TEK-SALON PİLOTU İÇİN: true <<<
PILOT_SIMPLE_PEOPLE_MODE=true

# --- Public studio registration (Sprint 49) ---
# Herkese açık "yeni stüdyo oluştur" (register-studio) açık mı?
#   false (TEK-SALON PİLOT — ÖNERİLEN): dışarıdan kimse yeni stüdyo oluşturamaz (register-studio → 403).
#          Login, davet-kabul ve mevcut Owner/Admin akışları ETKİLENMEZ. İlk pilot Owner'ı operatör açar
#          (bkz. PILOT-DEPLOY-DRY-RUN.md — "İlk pilot owner").
#   true  (tam SaaS): herkes yeni stüdyo + Owner hesabı oluşturur (v1.39.0 ve öncesi davranış).
# Bu değişken verilmezse docker-compose.prod.yml zaten false'a düşer (güvenli varsayılan).
STUDIO_REGISTRATION_ENABLED=false

# --- Backup encryption (Sprint 31D-2) ---
# ops/backup-postgres.sh bu passphrase ile yedeği gpg AES256 ile şifreler (.sql.gz.gpg). gpg kurulu olmalı.
# Prod'da ZORUNLU (yoksa backup fail-fast; şifresiz yedek üretilmez). Dev'de boşsa uyarı + şifresiz .sql.gz.
# KRİTİK SECRET: DB yedeğiyle AYNI yerde tutMA; ayrı güvenli yerde yedekle. Kayıp = eski şifreli yedekler
# kalıcı erişilemez. JWT_SECRET / MFA_ENCRYPTION_KEY ile birlikte kritik recovery secret setidir.
# Üret: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=CHANGE_ME_strong_backup_passphrase
