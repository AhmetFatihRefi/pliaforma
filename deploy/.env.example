# Pliaforma production değişkenleri — kopyalayın: cp deploy/.env.example deploy/.env
# Kullanım: docker compose --env-file deploy/.env -f docker-compose.prod.yml up -d --build

# --- PostgreSQL ---
POSTGRES_USER=pliaforma
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=pliaforma

# --- JWT (en az 32 BAYT; secret yoksa/kısaysa backend AÇILMAZ) ---
# UYARI: Production'da değer 'CHANGE_ME' içerirse backend AÇILMAZ (Sprint 31B-1 fail-fast guard).
# Gerçek, rastgele secret üretin, örn:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_byte_random_secret_value
JWT_ISSUER=Pliaforma
JWT_AUDIENCE=Pliaforma

# --- Seed admin (opsiyonel; ikisi de boşsa admin tohumlanmaz) ---
# UYARI: Production'da parola 'CHANGE_ME' veya bilinen örnek ('Admin!2345') içerirse backend AÇILMAZ.
# Güçlü/benzersiz bir parola verin ya da boş bırakın (admin tohumlanmaz).
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Genel origin (CORS allowlist + cookie/host beklentisi + e-posta link tabanı) ---
# nginx ile same-origin çalışıldığından CORS ana akış için gerekmez; yine de allowlist'e yazılır.
# Email__PublicOrigin de bunu kullanır (doğrulama/sıfırlama linkleri bu origin ile kurulur).
# Prod'da MUTLAKA https:// olmalı (CORS allowlist + Secure cookie + e-posta link tabanı bunu kullanır).
# TLS: deploy/certs/{fullchain,privkey}.pem yoksa nginx açılmaz (HTTPS zorunlu). Bkz. PILOT-DEPLOY-DRY-RUN.md.
PUBLIC_ORIGIN=https://your-domain.com

# --- İzleme (Prometheus/Grafana) — OPSİYONEL, pilotta KAPALI varsayılır ---
# Yalnız docker-compose.monitoring.yml çalıştırılacaksa gerekir. Grafana admin parolası ZORUNLU
# (yoksa monitoring compose hata verir); default admin/admin YOKTUR. Portlar 127.0.0.1'e bind'lidir.
GF_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password

# --- MFA (Sprint 31-MFA: Owner/StudioAdmin TOTP) ---
# Pilotta ZORUNLU. Mfa:Enabled=false ise Production'da backend AÇILMAZ (fail-fast).
# EncryptionKey TOTP secret'larını AES-256-GCM ile şifreler — KRITIK SECRET (JWT secret gibi yedekle).
# Kaybı → kullanıcılar yeniden MFA kurmak zorunda kalır (recovery code'lar bağımsız çalışır). Üret: openssl rand -base64 32
MFA_ENABLED=true
MFA_ENCRYPTION_KEY=CHANGE_ME_base64_min_32_byte_key

# --- E-posta (Sprint 16: doğrulama + şifre sıfırlama) ---
# SenderMode: Smtp (prod önerilen) | Log (yalnız dev/test, gönderim yok loglar) | Disabled (prod'da KULLANMAYIN).
# Smtp iken PublicOrigin + SMTP_HOST + EMAIL_FROM_ADDRESS ZORUNLU; eksikse backend AÇILMAZ (fail-fast).
# Prod'da SenderMode=Disabled → backend AÇILMAZ (bilinçliyse Email__AllowDisabledInProduction=true gerekir).
EMAIL_SENDER_MODE=Smtp
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Pliaforma
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_USE_TLS=true
