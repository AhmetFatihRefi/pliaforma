{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Pliaforma.Infrastructure.Services.LogEmailSender": "Debug"
    }
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 1000
  },
  "Auth": {
    "RequireEmailVerification": false,
    "EnableLockout": false
  },
  "Notifications": {
    "WorkerEnabled": false,
    "ReminderIntervalSeconds": 60
  }
}
