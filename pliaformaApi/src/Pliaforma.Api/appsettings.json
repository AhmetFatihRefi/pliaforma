{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=pliaforma;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "Pliaforma",
    "Audience": "Pliaforma",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "Seed": {
    "AdminEmail": "admin@pliaforma.local"
  },
  "Notifications": {
    "WorkerEnabled": true,
    "ReminderIntervalSeconds": 300
  }
}
