{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=pliaforma;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "Pliaforma",
    "Audience": "Pliaforma",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "Seed": {
    "AdminEmail": "admin@pliaforma.local"
  },
  "Email": {
    "SenderMode": "Log",
    "FromAddress": "noreply@pliaforma.local",
    "FromName": "Pliaforma",
    "PublicOrigin": "http://localhost:3000",
    "AllowDisabledInProduction": false,
    "ContactToAddress": "",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "UseTls": true
    }
  },
  "Notifications": {
    "WorkerEnabled": true,
    "ReminderIntervalSeconds": 300
  },
  "Pilot": {
    "SimplePeopleMode": false
  },
  "Registration": {
    "StudioRegistrationEnabled": true
  },
  "Mfa": {
    "TrustedDeviceDays": 30
  },
  "AuditPurge": {
    "Enabled": false,
    "DryRun": true,
    "IntervalMinutes": 1440,
    "BatchSize": 5000,
    "AuditRetentionDays": 730,
    "TokenRetentionBufferDays": 7
  }
}
