# Backend ortam değişkenleri (container/prod). Lokal geliştirmede bunlar yerine
# `dotnet user-secrets` kullanılır (Jwt:Secret, Seed:AdminPassword). appsettings'te SECRET TUTULMAZ.

# Bağlantı
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pliaforma;Username=postgres;Password=postgres

# JWT — en az 32 bayt; yoksa/kısaysa uygulama açılmaz (fail-fast)
Jwt__Secret=CHANGE_ME_min_32_byte_random_secret_value
Jwt__Issuer=Pliaforma
Jwt__Audience=Pliaforma

# Seed admin (opsiyonel)
Seed__AdminEmail=admin@pliaforma.local
Seed__AdminPassword=CHANGE_ME

# CORS allowlist (same-origin'de ana akış için gerekmez; doğrudan erişim senaryosu için)
Cors__Origins__0=http://localhost:3000

# E-posta (Sprint 16 — doğrulama + şifre sıfırlama)
# SenderMode: Log (dev/test, gönderim yok yalnız loglar) | Smtp (prod, gerçek gönderim) | Disabled (no-op).
# UYARI: PRODUCTION'da SenderMode=Disabled KULLANMAYIN — doğrulama/sıfırlama e-postaları GİTMEZ ve
#        kullanıcılar e-postalarını doğrulayamaz/şifrelerini sıfırlayamaz. Prod'da Disabled, ancak
#        Email__AllowDisabledInProduction=true ile BİLİNÇLİ açılabilir; aksi halde uygulama açılmaz (fail-fast).
# SenderMode=Smtp iken PublicOrigin + Smtp__Host + FromAddress ZORUNLUDUR (eksikse fail-fast).
Email__SenderMode=Smtp
Email__FromAddress=noreply@pliaforma.local
Email__FromName=Pliaforma
# Kullanıcıya görünen (frontend) origin — doğrulama/sıfırlama linkleri bununla kurulur (prod: https FQDN).
Email__PublicOrigin=https://app.pliaforma.local
Email__AllowDisabledInProduction=false
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=CHANGE_ME
Email__Smtp__UseTls=true
