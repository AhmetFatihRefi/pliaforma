# Backend ortam değişkenleri (container/prod). Lokal geliştirmede bunlar yerine
# `dotnet user-secrets` kullanılır (Jwt:Secret, Seed:AdminPassword). appsettings'te SECRET TUTULMAZ.

# Bağlantı
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pliaforma;Username=postgres;Password=postgres

# JWT — en az 32 bayt; yoksa/kısaysa uygulama açılmaz (fail-fast)
Jwt__Secret=CHANGE_ME_min_32_byte_random_secret_value
Jwt__Issuer=Pliaforma
Jwt__Audience=Pliaforma

# Seed admin (opsiyonel)
Seed__AdminEmail=admin@pliaforma.local
Seed__AdminPassword=CHANGE_ME

# CORS allowlist (same-origin'de ana akış için gerekmez; doğrudan erişim senaryosu için)
Cors__Origins__0=http://localhost:3000
